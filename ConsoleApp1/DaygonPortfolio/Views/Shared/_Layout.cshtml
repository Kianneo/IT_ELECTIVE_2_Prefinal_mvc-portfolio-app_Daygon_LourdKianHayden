<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Developer Portfolio</title>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
            --text-heading: #0f172a;
            --text-body: #334155;
            --text-muted: #64748b;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --border-color: #cbd5e1;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* High-Contrast Navbar */
        .navbar-custom {
            background-color: #0f172a;
            border-bottom: 2px solid #1e293b;
        }

        .brand-logo {
            font-weight: 800;
            font-size: 1.35rem;
            color: #ffffff !important;
        }

        .brand-logo i {
            color: #60a5fa;
        }

        .nav-link-custom {
            color: #e2e8f0 !important;
            font-weight: 600;
        }

        .nav-link-custom:hover {
            color: #60a5fa !important;
        }

        /* Hero Banner */
        .hero-banner {
            background: #ffffff;
            padding: 3rem 1rem 2.5rem;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

        .hero-title {
            font-weight: 800;
            font-size: 2.5rem;
            color: var(--text-heading);
        }

        .hero-subtitle {
            color: var(--text-body);
            max-width: 680px;
            margin: 0.5rem auto 1.25rem;
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Project Cards */
        .project-card {
            background-color: var(--bg-card);
            border: 2px solid var(--border-color);
            border-radius: 0.75rem;
            overflow: hidden;
            transition: all 0.2s ease-in-out;
            display: flex;
            flex-direction: column;
            height: 100%;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .project-card:hover {
            border-color: var(--primary);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .card-img-wrapper {
            position: relative;
            height: 180px;
            background: #e2e8f0;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .fallback-banner {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            font-size: 2.8rem;
        }

        /* High-Visibility Badges & Buttons */
        .badge-tech {
            background-color: #dbeafe;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.35rem 0.75rem;
            border-radius: 0.375rem;
        }

        .btn-primary-custom {
            background-color: var(--primary);
            color: #ffffff !important;
            font-weight: 700;
            border: none;
        }

        .btn-primary-custom:hover {
            background-color: var(--primary-hover);
        }

        .btn-outline-custom {
            border: 1px solid #94a3b8;
            color: #0f172a !important;
            background-color: #f1f5f9;
            font-weight: 700;
        }

        .btn-outline-custom:hover {
            background-color: #e2e8f0;
        }

        /* Inputs */
        .form-control-custom {
            background-color: #ffffff !important;
            border: 2px solid #cbd5e1 !important;
            color: #0f172a !important;
            font-size: 0.95rem;
            font-weight: 500;
        }

        .form-control-custom:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.25) !important;
        }

        footer {
            margin-top: auto;
            border-top: 1px solid var(--border-color);
            background-color: #0f172a;
            color: #cbd5e1;
            padding: 1.5rem 0;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container">
            <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-code me-2"></i>DaygonPortfolio
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom px-3" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-folder-open me-1"></i> Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom px-3" asp-controller="Home" asp-action="Privacy"><i class="fa-solid fa-shield-halved me-1"></i> Privacy</a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-primary-custom btn-sm px-3 rounded-pill" asp-controller="Auth" asp-action="Login">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Admin Login
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year DaygonPortfolio — ASP.NET Core MVC Project Showcase</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>